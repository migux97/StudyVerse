# Copiar a app/.env (no se sube al repo) y correr con:
#   flutter run --dart-define-from-file=.env
# Valores de `npx supabase status` (API URL y Publishable key). Esa key es
# pública; NUNCA poner acá la secret / service_role key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# URL pública de la versión web, para los links de invitación que se copian
# desde Android. En la web, si queda vacía, se usa la URL actual.
WEB_URL=
# Usuario del bot de Telegram (sin @), para el botón "Abrir en Telegram".
TELEGRAM_BOT_USERNAME=
# Notificaciones push (opcional). De Firebase: Configuración del proyecto →
# General (apps Web y Android) y Cloud Messaging → Certificados push web.
# Sin esto, las notificaciones quedan solo en la campanita de la app.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID_WEB=
FIREBASE_APP_ID_ANDROID=
FIREBASE_VAPID_KEY=
