# Copiar a supabase/functions/.env (no se sube al repo), o generarlo con
# supabase/scripts/configurar-funciones-local.ps1.
# En producción: `npx supabase secrets set --env-file supabase/functions/.env`.

# Lo inventás vos; tiene que coincidir con el secreto `internal_functions_secret`
# de Vault. Protege las funciones que llama la base (telegram-send, storage-cleanup).
INTERNAL_FUNCTIONS_SECRET=

# Token que da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=
# Lo inventás vos; se pasa a Telegram con setWebhook(secret_token=...).
TELEGRAM_WEBHOOK_SECRET=
# Opcional: para probar contra un Telegram simulado.
# TELEGRAM_API_BASE=http://host.docker.internal:8081
