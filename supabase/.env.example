# Copiar a supabase/.env (no se sube al repo). Lo lee `supabase start`.
# Credenciales OAuth de Google (Google Cloud Console → Credenciales → ID de cliente web).
# Redirect URI autorizado en Google: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Correos reales (códigos de registro, entrada y recuperación). Sin esto quedan
# en Mailpit. Con Gmail: activá la verificación en dos pasos y creá una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords.
SUPABASE_AUTH_EMAIL_SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
