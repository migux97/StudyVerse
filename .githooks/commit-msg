#!/bin/sh
# Rechaza commits con atribuciones a herramientas o con otro autor.
# Activar una vez por clon:  git config core.hooksPath .githooks

autor_esperado="migux97 <franbenastro@gmail.com>"
patron='co-authored-by|claude-session|generated with|claude code|anthropic'

if grep -v '^#' "$1" | grep -Eiq "$patron"; then
  echo "commit rechazado: el mensaje tiene una atribución prohibida:" >&2
  grep -v '^#' "$1" | grep -Ein "$patron" >&2
  exit 1
fi

for rol in AUTHOR COMMITTER; do
  ident=$(git var GIT_${rol}_IDENT | sed 's/ [0-9]* [-+][0-9]*$//')
  if [ "$ident" != "$autor_esperado" ]; then
    echo "commit rechazado: $rol es \"$ident\", tiene que ser \"$autor_esperado\"" >&2
    exit 1
  fi
done
